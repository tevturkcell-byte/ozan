// ===== SINAV İŞLEMLERİ =====
function addExam(){
  const studentId = +document.getElementById('ex-student').value;
  if(!studentId){ alert('Öğrenci seçiniz!'); return; }
  const exam = {
    id:Date.now(),
    name:document.getElementById('ex-name').value.trim()||'Deneme',
    date:document.getElementById('ex-date').value||new Date().toISOString().split('T')[0],
    type:document.getElementById('ex-type').value,
    studentId,
    tr:+document.getElementById('ex-tr').value||0,
    mat:+document.getElementById('ex-mat').value||0,
    fen:+document.getElementById('ex-fen').value||0,
    ink:+document.getElementById('ex-ink').value||0,
    din:+document.getElementById('ex-din').value||0,
    ing:+document.getElementById('ex-ing').value||0
  };
  DB.exams.push(exam);
  saveDB();
  ['ex-name','ex-tr','ex-mat','ex-fen','ex-ink','ex-din','ex-ing'].forEach(id=>document.getElementById(id).value='');
  renderAll();
}

function deleteExam(id){
  if(!confirm('Bu sınav sonucu silinsin mi?')) return;
  DB.exams = DB.exams.filter(e=>e.id!==id);
  saveDB(); renderAll();
}

function renderExams(){
  const tbody = document.querySelector('#examsTable tbody');
  const list = [...DB.exams].sort((a,b)=>new Date(b.date)-new Date(a.date));
  if(list.length===0){ tbody.innerHTML='<tr><td colspan="11" style="text-align:center;color:#888;padding:20px;">Henüz sınav sonucu yok.</td></tr>'; return; }
  tbody.innerHTML = list.map(e=>{
    const st = DB.students.find(s=>s.id===e.studentId);
    const total = e.tr+e.mat+e.fen+e.ink+e.din+e.ing;
    return `<tr>
      <td>${e.date}</td><td>${e.name}</td><td>${st?st.name:'?'}</td>
      <td>${e.tr}</td><td>${e.mat}</td><td>${e.fen}</td>
      <td>${e.ink}</td><td>${e.din}</td><td>${e.ing}</td>
      <td><b>${total.toFixed(2)}</b></td>
      <td><button class="btn btn-danger btn-sm" onclick="deleteExam(${e.id})">Sil</button></td>
    </tr>`;
  }).join('');
}

function updateStudentSelects(){
  const opts = DB.students.map(s=>`<option value="${s.id}">${s.name} (${s.class})</option>`).join('');
  ['ex-student','tp-student'].forEach(id=>{
    const el = document.getElementById(id);
    if(el) el.innerHTML = '<option value="">Seçiniz...</option>'+opts;
  });
}

// ===== TOPLU SINAV GİRİŞİ =====
function renderBulkTable(){
  const tbody = document.querySelector('#bulkTable tbody');
  const classFilter = document.getElementById('bk-class').value;
  let list = DB.students;
  if(classFilter) list = list.filter(s=>s.class===classFilter);
  if(list.length===0){ tbody.innerHTML='<tr><td colspan="8" style="text-align:center;color:#888;padding:20px;">Bu sınıfta öğrenci yok.</td></tr>'; return; }
  tbody.innerHTML = list.map(s=>`
    <tr data-sid="${s.id}">
      <td><b>${s.name}</b></td>
      <td><input type="number" min="0" max="20" step="0.25" class="bk-tr" style="width:60px;padding:4px;"></td>
      <td><input type="number" min="0" max="20" step="0.25" class="bk-mat" style="width:60px;padding:4px;"></td>
      <td><input type="number" min="0" max="20" step="0.25" class="bk-fen" style="width:60px;padding:4px;"></td>
      <td><input type="number" min="0" max="10" step="0.25" class="bk-ink" style="width:60px;padding:4px;"></td>
      <td><input type="number" min="0" max="10" step="0.25" class="bk-din" style="width:60px;padding:4px;"></td>
      <td><input type="number" min="0" max="10" step="0.25" class="bk-ing" style="width:60px;padding:4px;"></td>
      <td class="bk-total">0.00</td>
    </tr>
  `).join('');
  tbody.querySelectorAll('tr').forEach(tr=>{
    tr.querySelectorAll('input').forEach(inp=>{
      inp.addEventListener('input',()=>{
        const get = c=>+tr.querySelector('.'+c).value||0;
        const total = get('bk-tr')+get('bk-mat')+get('bk-fen')+get('bk-ink')+get('bk-din')+get('bk-ing');
        tr.querySelector('.bk-total').innerHTML = total.toFixed(2);
      });
    });
  });
}

function saveBulkExams(){
  const name = document.getElementById('bk-name').value.trim();
  const date = document.getElementById('bk-date').value;
  if(!name || !date){ alert('Deneme adı ve tarih zorunlu!'); return; }
  const rows = document.querySelectorAll('#bulkTable tbody tr');
  let count = 0;
  rows.forEach(tr=>{
    const sid = +tr.dataset.sid;
    const tr_v = +tr.querySelector('.bk-tr').value;
    const mat_v = +tr.querySelector('.bk-mat').value;
    const fen_v = +tr.querySelector('.bk-fen').value;
    const ink_v = +tr.querySelector('.bk-ink').value;
    const din_v = +tr.querySelector('.bk-din').value;
    const ing_v = +tr.querySelector('.bk-ing').value;
    const total = tr_v+mat_v+fen_v+ink_v+din_v+ing_v;
    if(total>0){
      DB.exams.push({
        id:Date.now()+Math.random(),
        name, date, type:'Genel LGS', studentId:sid,
        tr:tr_v, mat:mat_v, fen:fen_v, ink:ink_v, din:din_v, ing:ing_v
      });
      count++;
    }
  });
  saveDB();
  alert(`${count} öğrenci için sınav kaydedildi.`);
  renderAll();
}

// ===== KONU TAKİBİ =====
function addTopic(){
  const studentId = +document.getElementById('tp-student').value;
  if(!studentId){ alert('Öğrenci seçiniz!'); return; }
  DB.topics.push({
    id:Date.now(),
    studentId,
    subject:document.getElementById('tp-subject').value,
    topic:document.getElementById('tp-topic').value.trim(),
    status:document.getElementById('tp-status').value
  });
  saveDB();
  document.getElementById('tp-topic').value='';
  renderTopics();
}

function deleteTopic(id){
  DB.topics = DB.topics.filter(t=>t.id!==id);
  saveDB(); renderTopics();
}

function renderTopics(){
  const tbody = document.querySelector('#topicsTable tbody');
  if(DB.topics.length===0){ tbody.innerHTML='<tr><td colspan="5" style="text-align:center;color:#888;padding:20px;">Kayıt yok.</td></tr>'; return; }
  tbody.innerHTML = DB.topics.map(t=>{
    const st = DB.students.find(s=>s.id===t.studentId);
    const badge = t.status==='Tamamlandı'?'badge-tamam':(t.status==='Çalışıyor'?'badge-devam':'badge-eksik');
    return `<tr>
      <td>${st?st.name:'?'}</td><td>${t.subject}</td><td>${t.topic}</td>
      <td><span class="badge ${badge}">${t.status}</span></td>
      <td><button class="btn btn-danger btn-sm" onclick="deleteTopic(${t.id})">Sil</button></td>
    </tr>`;
  }).join('');
}

// ===== GÖREVLER =====
function addTask(){
  DB.tasks.push({
    id:Date.now(),
    task:document.getElementById('tk-task').value.trim(),
    person:document.getElementById('tk-person').value.trim(),
    date:document.getElementById('tk-date').value,
    status:document.getElementById('tk-status').value
  });
  saveDB();
  ['tk-task','tk-person'].forEach(id=>document.getElementById(id).value='');
  renderTasks();
}

function deleteTask(id){
  DB.tasks = DB.tasks.filter(t=>t.id!==id);
  saveDB(); renderTasks();
}

function renderTasks(){
  const tbody = document.querySelector('#tasksTable tbody');
  if(DB.tasks.length===0){ tbody.innerHTML='<tr><td colspan="5" style="text-align:center;color:#888;padding:20px;">Kayıt yok.</td></tr>'; return; }
  tbody.innerHTML = DB.tasks.map(t=>{
    const badge = t.status==='Tamamlandı'?'badge-tamam':(t.status==='Devam Ediyor'?'badge-devam':'badge-beklemede');
    return `<tr>
      <td>${t.task}</td><td>${t.person}</td><td>${t.date}</td>
      <td><span class="badge ${badge}">${t.status}</span></td>
      <td><button class="btn btn-danger btn-sm" onclick="deleteTask(${t.id})">Sil</button></td>
    </tr>`;
  }).join('');
}

// ===== RAPORLAR =====
function renderReports(){
  const tbody = document.querySelector('#reportsTable tbody');
  if(DB.students.length===0){ tbody.innerHTML='<tr><td colspan="7" style="text-align:center;color:#888;padding:20px;">Öğrenci yok.</td></tr>'; return; }
  tbody.innerHTML = DB.students.map(s=>{
    const exams = DB.exams.filter(e=>e.studentId===s.id).sort((a,b)=>new Date(a.date)-new Date(b.date));
    const firstNet = exams.length>0 ? exams[0].tr+exams[0].mat+exams[0].fen+exams[0].ink+exams[0].din+exams[0].ing : null;
    const lastNet = exams.length>0 ? exams[exams.length-1].tr+exams[exams.length-1].mat+exams[exams.length-1].fen+exams[exams.length-1].ink+exams[exams.length-1].din+exams[exams.length-1].ing : null;
    const diff = (firstNet!==null&&lastNet!==null) ? (lastNet-firstNet) : null;
    const topicCount = DB.topics.filter(t=>t.studentId===s.id && t.status!=='Tamamlandı').length;
    const diffColor = diff===null?'#888':(diff>0?'#10b981':(diff<0?'#ef4444':'#666'));
    const diffText = diff===null?'-':(diff>0?'+'+diff.toFixed(2):diff.toFixed(2));
    return `<tr>
      <td><b>${s.name}</b></td><td>${s.class}</td>
      <td>${firstNet!==null?firstNet.toFixed(2):'-'}</td>
      <td>${lastNet!==null?lastNet.toFixed(2):'-'}</td>
      <td style="color:${diffColor};font-weight:bold;">${diffText}</td>
      <td>${topicCount}</td>
      <td><span class="badge badge-${s.group.toLowerCase()}">${s.group}</span></td>
    </tr>`;
  }).join('');
}

// ===== DASHBOARD =====
function renderDashboard(){
  document.getElementById('stat-students').textContent = DB.students.length;
  document.getElementById('stat-exams').textContent = DB.exams.length;
  let totalNet = 0, count = 0;
  DB.students.forEach(s=>{
    const net = getLastNet(s.id);
    if(net!==null){ totalNet+=net; count++; }
  });
  document.getElementById('stat-avg').textContent = count>0?(totalNet/count).toFixed(1):'0.0';
  const priority = DB.students.filter(s=>{ const n=getLastNet(s.id); return n!==null && n<35; });
  document.getElementById('stat-priority').textContent = priority.length;
  const pl = document.getElementById('priorityList');
  if(priority.length===0){ pl.innerHTML='<div style="color:#888;padding:10px;">Tebrikler! Takip edilmesi gereken öğrenci yok.</div>'; }
  else {
    pl.innerHTML = priority.map(s=>{
      const net = getLastNet(s.id);
      return `<div class="priority-item">
        <div class="name">${s.name}</div>
        <div class="net">${s.class} • ${s.group} • Son Net: <b>${net.toFixed(2)}</b></div>
      </div>`;
    }).join('');
  }
  const chart = document.getElementById('subjectChart');
  if(DB.exams.length===0){ chart.innerHTML='<div style="color:#888;padding:40px;text-align:center;width:100%;">Henüz sınav verisi yok.</div>'; return; }
  const subjects = ['tr','mat','fen','ink','din','ing'];
  const labels = ['Türkçe','Matematik','Fen','İnkılap','Din','İngilizce'];
  const maxes = [20,20,20,10,10,10];
  const avgs = subjects.map((s,i)=>{
    const sum = DB.exams.reduce((a,e)=>a+e[s],0);
    return (sum/DB.exams.length/maxes[i])*100;
  });
  chart.innerHTML = avgs.map((v,i)=>`
    <div class="bar" style="height:${v}%;">
      <div class="bar-value">${(v/100*maxes[i]).toFixed(1)}</div>
      <div class="bar-label">${labels[i]}</div>
    </div>
  `).join('');
}

// ===== MODAL =====
function openModal(id){ document.getElementById(id).classList.add('active'); }
function closeModal(id){ document.getElementById(id).classList.remove('active'); }

// ===== ÖĞRENCİ DETAY RAPORU =====
function showStudentDetail(id){
  currentStudentId = id;
  const st = DB.students.find(s=>s.id===id);
  if(!st) return;
  const exams = DB.exams.filter(e=>e.studentId===id).sort((a,b)=>new Date(a.date)-new Date(b.date));
  const topics = DB.topics.filter(t=>t.studentId===id);
  const lastNet = getLastNet(id);
  const lgs = estimateLGSScore(id);
  
  document.getElementById('sd-title').innerHTML = `📊 ${st.name} - Detaylı Rapor`;
  
  let html = `
    <div class="student-detail-grid">
      <div class="detail-box"><div class="lbl">Sınıf</div><div class="val">${st.class}</div></div>
      <div class="detail-box"><div class="lbl">Grup</div><div class="val">${st.group}</div></div>
      <div class="detail-box"><div class="lbl">Veli Tel</div><div class="val">${st.phone||'-'}</div></div>
      <div class="detail-box"><div class="lbl">Toplam Sınav</div><div class="val">${exams.length}</div></div>
      <div class="detail-box"><div class="lbl">Son Net</div><div class="val">${lastNet!==null?lastNet.toFixed(2):'-'}</div></div>
      <div class="detail-box"><div class="lbl">Tahmini LGS</div><div class="val">${lgs}</div></div>
    </div>
  `;
  
  if(exams.length>0){
    html += `<h4 style="color:#4a4a8a;margin:15px 0 8px;">📈 Sınav Gelişim Grafiği</h4><div class="mini-chart">`;
    const maxNet = 90;
    exams.forEach((e,i)=>{
      const total = e.tr+e.mat+e.fen+e.ink+e.din+e.ing;
      const h = (total/maxNet)*100;
      html += `<div class="mini-bar" style="height:${h}%;" title="${e.name}: ${total.toFixed(2)} net">
        <div class="mini-bar-label">${i+1}</div>
      </div>`;
    });
    html += `</div>`;
    
    html += `<h4 style="color:#4a4a8a;margin:20px 0 8px;">📋 Sınav Geçmişi</h4>
    <div style="overflow-x:auto;"><table>
      <thead><tr><th>Tarih</th><th>Deneme</th><th>TR</th><th>MAT</th><th>FEN</th><th>İNK</th><th>DİN</th><th>İNG</th><th>Toplam</th></tr></thead>
      <tbody>`;
    exams.forEach(e=>{
      const total = e.tr+e.mat+e.fen+e.ink+e.din+e.ing;
      html += `<tr><td>${e.date}</td><td>${e.name}</td><td>${e.tr}</td><td>${e.mat}</td><td>${e.fen}</td><td>${e.ink}</td><td>${e.din}</td><td>${e.ing}</td><td><b>${total.toFixed(2)}</b></td></tr>`;
    });
    html += `</tbody></table></div>`;
  } else {
    html += `<div class="alert alert-warning" style="margin-top:15px;">Bu öğrenci için henüz sınav kaydı yok.</div>`;
  }
  
  if(topics.length>0){
    html += `<h4 style="color:#4a4a8a;margin:20px 0 8px;">📚 Konu Durumu (${topics.length} konu)</h4>
    <div style="overflow-x:auto;"><table>
      <thead><tr><th>Ders</th><th>Konu</th><th>Durum</th></tr></thead><tbody>`;
    topics.forEach(t=>{
      const badge = t.status==='Tamamlandı'?'badge-tamam':(t.status==='Çalışıyor'?'badge-devam':'badge-eksik');
      html += `<tr><td>${t.subject}</td><td>${t.topic}</td><td><span class="badge ${badge}">${t.status}</span></td></tr>`;
    });
    html += `</tbody></table></div>`;
  }
  
  document.getElementById('sd-content').innerHTML = html;
  openModal('studentDetailModal');
}

