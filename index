function importData(e){
  const file = e.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = ev=>{
    try {
      const data = JSON.parse(ev.target.result);
      if(confirm('Mevcut veriler silinip yeni veriler yüklenecek. Emin misiniz?')){
        DB = data;
        saveDB(); renderAll();
        alert('Veriler başarıyla yüklendi!');
      }
    } catch(err){ alert('Geçersiz JSON dosyası!'); }
  };
  reader.readAsText(file);
}

function resetAll(){
  if(!confirm('TÜM VERİLER SİLİNECEK! Emin misiniz?')) return;
  if(!confirm('Son uyarı: Bu işlem geri alınamaz!')) return;
  DB = { students:[], exams:[], topics:[], tasks:[] };
  saveDB(); renderAll();
  alert('Tüm veriler sıfırlandı.');
}

